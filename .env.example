# AgriTrust API base URL (the FastAPI backend in DTA-ADP-DASHBOARD/backend).
# Leave unset in development: the app uses http://<your computer running Expo>:8000/api.
# For a phone on the same Wi-Fi, start the backend with: uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api

# Offline demo mode (development builds only): no sign-in, built-in sample data, no backend.
# It is ON by default in development (Expo Go / dev builds). Release builds always require sign-in.
# To sign in against the real backend while developing, set:
# EXPO_PUBLIC_DISABLE_LOGIN=false
